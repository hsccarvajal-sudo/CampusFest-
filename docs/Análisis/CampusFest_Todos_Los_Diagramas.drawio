rokeColor=#FF00FF;strokeWidth=2.2;endArrow=classic;endFill=1;fontColor=#1A1A1A;fontFamily=Arial;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;entryX=0.1;entryY=0;" value="Cancelar reserva" source="n0003" target="n0006"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t0010" parent="1" vertex="1" value="Confirmadas y pendientes vigentes ocupan cupo. Vencidas y canceladas NO ocupan cupo." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#1A1A1A;fontSize=20;fontFamily=Arial;fontStyle=1;"><mxGeometry x="175" y="570" width="1190" height="50" as="geometry"/></mxCell><mxCell id="t0011" parent="1" vertex="1" value="Fuente: reglas de CampusFest y reto 5. La transición Pendiente → Cancelada representa la acción de cancelar; el enunciado no especifica todos los estados de origen posibles." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#555555;fontSize=16;fontFamily=Arial;"><mxGeometry x="38" y="755" width="1458" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
