=#1A1A1A;fontSize=18;fontFamily=Arial;fontStyle=1;"><mxGeometry x="1050" y="535" width="72" height="32" as="geometry"/></mxCell><mxCell id="t0019" parent="1" vertex="1" value="La operación calcularDisponibilidad() corresponde al control CalculoDisponibilidad, no a la entidad Evento ni a PantallaEventos." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#1A1A1A;fontSize=20;fontFamily=Arial;fontStyle=1;"><mxGeometry x="140" y="1000" width="1550" height="55" as="geometry"/></mxCell><mxCell id="t0020" parent="1" vertex="1" value="Atributos, tipos y firmas son una propuesta conceptual mínima deducida de los requisitos (no están enumerados literalmente en la guía). No representan diseño técnico ni código." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#555555;fontSize=16;fontFamily=Arial;"><mxGeometry x="38" y="1150" width="1778" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="03 - Estados de Reserva" id="imported_10_2"><mxGraphModel dx="1800" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="850" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0001" parent="1" vertex="1" value="CAMPUSFEST  |  11 - Estados de Reserva" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#1A1A1A;fontSize=23;fontFamily=Arial;fontStyle=1;"><mxGeometry x="38" y="14" width="1460" height="45" as="geometry"/></mxCell><mxCell id="t0002" parent="1" vertex="1" value="UNILLANOS  ·  Ingeniería de Software I  ·  Análisis de objetos (Schach, capítulo 13)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#555555;fontSize=14;fontFamily=Arial;"><mxGeomet